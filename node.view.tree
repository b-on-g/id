 14.05,16.27 14.05,14.65C14.05,13.58 13.12,12.71 11.97,12.71C10.82,12.71 9.89,13.58 9.89,14.65C9.89,16.36 10.55,17.96 11.76,19.16C12.71,20.1 13.62,20.62 15.03,21C15.3,21.08 15.45,21.36 15.38,21.62C15.33,21.85 15.12,22 14.91,22Z

$mol_paragraph $mol_view
	line_height 24
	letter_width 7
	width_limit +Infinity
	row_width 0
	sub / <= title

$mol_avatar $mol_icon
	view_box \0 0 24 24
	id \
	path \M 12 12 l 0 0 M 0 0 l 0 0 M 24 24 l 0 0 M 0 24 l 0 0 M 24 0 l 0 0

$mol_icon_check $mol_icon path \M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z

$mol_speck $mol_view
	theme \$mol_theme_accent
	sub /
		<= value null

$mol_button $mol_view
	enabled true
	click? null
	event_click? null
	status? /
	event *
		^
		click? <=> activate? <=> event_activate? null
		dblclick? <=> clicks? null
		keydown? <=> key_press? <=> event_key_press? null
	attr *
		^
		disabled <= disabled false
		role \button
		tabindex <= tab_index 0
		title <= hint_safe <= hint \
	sub /$mol_view_content
		<= title
	Speck $mol_speck
		value <= error \

$mol_button_typed $mol_button
	minimal_height 40
	minimal_width 40

$mol_button_minor $mol_button_typed

$bog_id_row $mol_button_minor
	current false
	attr *
		^
		bog_id_row_current <= current
	sub /
		<= Face $mol_view
			sub <= face /
		<= Info $mol_view
			sub <= info /
				<= Name $mol_view
					sub /
						<= name \
				<= Note $mol_view
					sub /
						<= note \
		<= Tail $mol_view
			sub <= tail /

$mol_list $mol_view
	render_visible_only true
	render_over 0.1
	sub <= rows /$mol_view
		<= Gap_before $mol_view style * paddingTop <= gap_before 0
		<= Empty $mol_view
		<= Gap_after $mol_view style * paddingTop <= gap_after 0
	item_height_min* 1
	item_width_min* 1
	view_window_shift? 0
	view_window /
		0
		0

$mol_icon_plus $mol_icon path \M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z

$mol_icon_account $mol_icon path \M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z

$mol_icon_account_plus $mol_icon path \M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z

$mol_hotkey2 $mol_plugin
	event *
		^
		keydown? <=> keydown? null
	action *

$mol_hotkey $mol_hotkey2
	key *
	mod_ctrl false
	mod_alt false
	mod_shift false

$mol_string $mol_view
	dom_name \input
	enabled true
	minimal_height 40
	autocomplete false
	selection? /number
		0
		0
	auto /
		<= selection_watcher null
		<= error_report null
	field *
		^
		disabled <= disabled false
		value <= value_changed? <=> value? \
		placeholder <= hint_visible <= hint \
		spellcheck <= spellcheck true
		autocomplete <= autocomplete_native \
		selectionEnd <= selection_end 0
		selectionStart <= selection_start 0
		inputMode <= keyboard \text
		enterkeyhint <= enter \go
	attr *
		^
		maxlength <= length_max +Infinity
		type <= type? \text
	event *
		^
		input? <=> event_change? null
	plugins /
		<= Submit $mol_hotkey
			mod_ctrl <= submit_with_ctrl false
			key * enter? <=> submit? null

$mol_button_major $mol_button_minor
	theme \$mol_theme_base

$mol_icon_logout $mol_icon path \M17 7L15.59 8.41L18.17 11H8V13H18.17L15.59 15.58L17 17L22 12M4 5H12V3H4C2.9 3 2 3.9 2 5V19C2 20.1 2.9 21 4 21H12V19H4V5Z

$bog_id_app $mol_scroll
	title @ \Гипер ID
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
	sub /
		<= Column $mol_view
			sub <= panels /
				<= Login $mol_list
					rows <= login_rows /
						<= Brand $mol_view
							sub /
								<= Brand_icon $mol_icon_fingerprint
								<= title
						<= Head $mol_paragraph
							title <= head \
						<= Accounts $mol_list
							rows <= account_rows /
								<= Account* $bog_id_row
									current <= account_current* false
									name <= account_name* \
									note <= account_note* \
									click? <=> account_open*? null
									face /
										<= Account_face* $mol_avatar
											id <= account_id* \
									tail <= account_tail* /
										<= Account_check* $mol_icon_check
						<= Add $bog_id_row
							name @ \Добавить аккаунт
							click? <=> add_open? null
							face /
								<= Add_icon $mol_icon_plus
						<= Enter $bog_id_row
							name @ \Войти по биометрии
							note @ \Отпечаток, лицо или ключ доступа
							click? <=> passkey_enter? null
							face /
								<= Enter_icon $mol_icon_fingerprint
						<= Make $bog_id_row
							name @ \Создать новый аккаунт
							note @ \С отдельным ключом и приложениями
							click? <=> account_make? null
							face /
								<= Make_icon $mol_icon_account_plus
						<= Back $mol_button_minor
							title @ \Назад
							click? <=> add_close? null
						<= Enter_status $mol_paragraph
							title <= enter_status \
						<= Draft $mol_string
							hint @ \Как вас зовут
							value? <=> name_draft? \
						<= Consent_text $mol_paragraph
							title <= consent_text \
						<= Consent_self $mol_paragraph
							title @ \Это ваш собственный ключ: войдите из приложения с отдельным ключом
						<= Consent_wait $mol_paragraph
							title @ \Ждём данные аккаунта из Гипер Базы…
						<= Approve $mol_button_major
							title <= approve_title \
							enabled <= approve_enabled true
							click? <=> approve? null
						<= Reject $mol_button_minor
							title @ \Отмена
							click? <=> reject? null
				<= Profile $mol_list
					rows <= profile_rows /
						<= Profile_head $mol_paragraph
							title @ \Профиль
						<= Name $mol_string
							hint @ \Как вас показывать приложениям
							value? <=> name? \
						<= Bind $bog_id_row
							name <= passkey_bind_title @ \Включить вход по биометрии
							note <= bind_note \
							click? <=> passkey_bind? null
							face /
								<= Bind_icon $mol_icon_fingerprint
						<= Bind_status $mol_paragraph
							title <= bind_status \
						<= Exit $bog_id_row
							name @ \Выйти на этом устройстве
							note @ \Вернуться можно по биометрии
							click? <=> account_exit? null
							face /
								<= Exit_icon $mol_icon_logout
				<= Grants_panel $mol_list
					rows /
						<= Grants_head $mol_paragraph
							title @ \Подключённые приложения
						<= Grants $mol_list
							rows <= grant_rows /
								<= Grant* $mol_list
									rows <= grant_parts* /
										<= Grant_head* $mol_view
											sub /
												<= Grant_title* $mol_paragraph
													title <= grant_title* \
												<= Grant_revoke* $mol_button_minor
													title @ \Отозвать всё
													enabled <= grant_active* true
													click? <=> grant_revoke*? null
										<= App* $mol_view
											sub /
												<= App_title* $mol_paragraph
													title <= app_title* \
												<= App_revoke* $mol_button_minor
													title @ \Отозвать
													click? <=> app_revoke*? null
	head_pick @ \Выберите аккаунт для входа в {app}
	head_own @ \Ваши аккаунты
	head_add @ \Добавление аккаунта
	account_locked @ \Нужен вход по биометрии
	account_noname @ \Без имени
	approve_as @ \Войти как {name}
	approve_plain @ \Войти
	consent_template @ \Приложение получит доступ к разделу «{scope}» и увидит ваше имя. Ключ аккаунта остаётся у вас
	grant_template @ \{app} · {scope}
	device_template @ \Устройство {lord}
	passkey_rebind_title @ \Привязать ещё одну биометрию
	passkey_done @ \Вход по биометрии включён
	passkey_none @ \Без неё аккаунт живёт только в этом браузере
	passkey_wait @ \Ждём зашифрованный ключ из Базы…
	passkey_offline @ \Нет связи с Гипер Базой. Вход продолжится сам, когда она появится
	passkey_unsaved @ \Нет связи с Гипер Базой: пока войти можно только на этом устройстве
	passkey_wrong @ \Этот ключ доступа не открывает аккаунт
	passkey_foreign @ \Это ключ доступа другого приложения. Выберите другой
	passkey_cancel @ \Вход отменён или на устройстве нет подходящего ключа
	passkey_noprf @ \Хранилище ключа не отдало секрет PRF. Создайте ключ заново и выберите в окне браузера другое место: Связку ключей iCloud или Google Менеджер паролей. Профиль Chrome и Bitwarden PRF не дают
	passkey_again @ \Ключ создан. Нажмите ещё раз, чтобы подтвердить
