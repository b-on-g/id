$mol_scroll $mol_view
	scroll_top? 0
	scroll_left? 0
	attr *
		^
		tabindex <= tabindex -1
	event *
		^
		scroll? <=> event_scroll? null

$mol_page $mol_view
	dom_name \article
	attr *
		^
		tabIndex <= tabindex -1
	sub /
		<= Head $mol_view
			minimal_height 64
			dom_name \header
			sub <= head /
				<= Title $mol_view
					dom_name \h1
					sub <= title_content /
						<= Logo null
						<= title
				<= Tools $mol_view
					sub <= tools /$mol_view_content
		<= Body $mol_scroll
			scroll_top? => body_scroll_top?
			sub <= body_content /
				<= Body_content $mol_view
					sub <= body /$mol_view
		<= Foot $mol_view
			dom_name \footer
			sub <= foot /$mol_view

$mol_theme_auto $mol_plugin
	light \$mol_theme_light
	attr * mol_theme <= theme <= dark \$mol_theme_dark

$mol_paragraph $mol_view
	line_height 24
	letter_width 7
	width_limit +Infinity
	row_width 0
	sub / <= title

$mol_speck $mol_view
	theme \$mol_theme_accent
	sub /
		<= value null

$mol_button $mol_view
	enabled true
	click? null
	event_click? null
	status? /
	event *
		^
		click? <=> activate? <=> event_activate? null
		dblclick? <=> clicks? null
		keydown? <=> key_press? <=> event_key_press? null
	attr *
		^
		disabled <= disabled false
		role \button
		tabindex <= tab_index 0
		title <= hint_safe <= hint \
	sub /$mol_view_content
		<= title
	Speck $mol_speck
		value <= error \

$mol_button_typed $mol_button
	minimal_height 40
	minimal_width 40

$mol_button_minor $mol_button_typed

$mol_button_major $mol_button_minor
	theme \$mol_theme_base

$mol_row $mol_view

$mol_list $mol_view
	render_visible_only true
	render_over 0.1
	sub <= rows /$mol_view
		<= Gap_before $mol_view style * paddingTop <= gap_before 0
		<= Empty $mol_view
		<= Gap_after $mol_view style * paddingTop <= gap_after 0
	item_height_min* 1
	item_width_min* 1
	view_window_shift? 0
	view_window /
		0
		0

$mol_hotkey2 $mol_plugin
	event *
		^
		keydown? <=> keydown? null
	action *

$mol_hotkey $mol_hotkey2
	key *
	mod_ctrl false
	mod_alt false
	mod_shift false

$mol_string $mol_view
	dom_name \input
	enabled true
	minimal_height 40
	autocomplete false
	selection? /number
		0
		0
	auto /
		<= selection_watcher null
		<= error_report null
	field *
		^
		disabled <= disabled false
		value <= value_changed? <=> value? \
		placeholder <= hint_visible <= hint \
		spellcheck <= spellcheck true
		autocomplete <= autocomplete_native \
		selectionEnd <= selection_end 0
		selectionStart <= selection_start 0
		inputMode <= keyboard \text
		enterkeyhint <= enter \go
	attr *
		^
		maxlength <= length_max +Infinity
		type <= type? \text
	event *
		^
		input? <=> event_change? null
	plugins /
		<= Submit $mol_hotkey
			mod_ctrl <= submit_with_ctrl false
			key * enter? <=> submit? null

$mol_labeler $mol_list
	rows /
		<= Label $mol_view
			minimal_height 32
			sub <= label /$mol_view_content
				<= title
		<= Content $mol_view
			minimal_height 24
			sub <= content /

$bog_id_app $mol_page
	title @ \Гипер ID
	plugins /
		<= Theme $mol_theme_auto
	body /
		<= Consent $mol_list
			rows <= consent_rows /
				<= Consent_text $mol_paragraph
					title <= consent_text \
				<= Consent_self $mol_paragraph
					title @ \Это ваш собственный ключ: войдите из приложения с отдельным ключом
				<= Consent_tools $mol_row
					sub /
						<= Approve $mol_button_major
							title @ \Разрешить
							enabled <= approve_enabled true
							click? <=> approve? null
						<= Reject $mol_button_minor
							title @ \Отклонить
							click? <=> reject? null
		<= Name_label $mol_labeler
			title @ \Имя
			content /
				<= Name $mol_string
					hint @ \Как вас показывать приложениям
					value? <=> name? \
		<= Lord_label $mol_labeler
			title @ \Ваш лорд
			content /
				<= Lord $mol_paragraph
					title <= lord \
		<= Passkey_label $mol_labeler
			title @ \Passkey
			content /
				<= Passkey_tools $mol_row
					sub /
						<= Passkey_bind $mol_button_minor
							title <= passkey_bind_title @ \Привязать passkey
							click? <=> passkey_bind? null
						<= Passkey_enter $mol_button_minor
							title @ \Войти по passkey
							click? <=> passkey_enter? null
				<= Passkey_status $mol_paragraph
					title <= passkey_status \
		<= Grants_label $mol_labeler
			title @ \Подключённые приложения
			content /
				<= Grants $mol_list
					rows <= grant_rows /
						<= Grant* $mol_list
							rows <= grant_parts* /
								<= Grant_head* $mol_row
									sub /
										<= Grant_title* $mol_paragraph
											title <= grant_title* \
										<= Grant_revoke* $mol_button_minor
											title @ \Отозвать всё
											enabled <= grant_active* true
											click? <=> grant_revoke*? null
								<= App* $mol_row
									sub /
										<= App_title* $mol_paragraph
											title <= app_title* \
										<= App_revoke* $mol_button_minor
											title @ \Отозвать
											click? <=> app_revoke*? null
	consent_template @ \{app} просит доступ «{scope}»
	grant_template @ \{app} · {scope}
	device_template @ \Устройство {lord}
	passkey_rebind_title @ \Перепривязать passkey
	passkey_done @ \Passkey привязан, ключ зашифрован им в Базе
	passkey_none @ \Привяжите passkey, чтобы войти с другого устройства
	passkey_wait @ \Ждём зашифрованный ключ из Базы…
	passkey_wrong @ \Этот passkey не открывает ключ
